{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/scripts/hooks/codex_session_start.py\"",
            "timeout": 10,
            "statusMessage": "Loading vibe memory bootstrap"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/scripts/hooks/codex_user_prompt_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking vibe task protocol"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/scripts/hooks/codex_pre_tool_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking dangerous shell command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/scripts/hooks/codex_stop_memory_guard.py\"",
            "timeout": 30,
            "statusMessage": "Running vibe memory consistency check"
          }
        ]
      }
    ]
  }
}
